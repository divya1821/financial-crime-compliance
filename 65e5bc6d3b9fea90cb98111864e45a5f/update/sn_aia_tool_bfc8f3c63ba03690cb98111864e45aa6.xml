<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sn_aia_tool">
    <sn_aia_tool action="INSERT_OR_UPDATE">
        <active>true</active>
        <description>Get the individual number with the case number. Can be used if the individual number is not available.</description>
        <input_schema>[{"name":"case_number","description":"Case Number"}]</input_schema>
        <name>Get the individual number</name>
        <record_type>custom</record_type>
        <script><![CDATA[(function(inputs) {
    // only string inputs are allowed 
    // return outputs object where the keys in it are understandable by LLM
    var gr = new GlideRecord('x_vuram_financia_0_fcc_kyc_cases');
    gr.get('number', inputs.case_number);
    return gr.individual.number.toString();
})(inputs);]]></script>

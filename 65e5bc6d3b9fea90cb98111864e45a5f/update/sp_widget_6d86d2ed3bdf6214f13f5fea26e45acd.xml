        <client_script><![CDATA[api.controller = function() {
  var c = this;

  c.$onInit = function() {
    const checkbox = document.getElementById('only-account-holder');
    const secondarySection = document.getElementById('secondary-section');

    function toggleSecondary() {
      if (checkbox.checked) {
        secondarySection.style.display = 'none';  // Hide secondary
      } else {
        secondarySection.style.display = 'block'; // Show secondary
      }
    }

    // Run once on load (default checked, so secondary hidden)
    toggleSecondary();

    // Add listener
    checkbox.addEventListener('change', toggleSecondary);

    // Application method toggle
    const methodSelect = document.getElementById('application-method');
    if (methodSelect) {
      methodSelect.addEventListener('change', function() {
        const uploadRow = document.getElementById('application-upload-row');
        if (this.value === 'online') {
          uploadRow.style.display = 'flex';
        } else {
          uploadRow.style.display = 'none';
        }
      });
    }
  };
};
]]></client_script>
        <controller_as>c</controller_as>

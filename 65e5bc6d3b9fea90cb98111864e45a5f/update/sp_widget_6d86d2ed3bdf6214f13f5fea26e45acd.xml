        <template><![CDATA[<header class="breadcrumb-header">
  <div class="breadcrumb">
    <a href="/fcc_kyc">Home</a> &gt; 
    <a href="/fcc_kyc?id=fcc_kyc_individual_upload_document">Document Upload</a>
  </div>
  <div class="step-info">
    Step 1 of 8<br>Current: Document Upload
  </div>
</header>

<div class="section-title">
        Document Upload
    </div>

<!-- Primary Section -->
<div id="primary-section">
  <h3>Primary Account Holder</h3>
  <div class="document-upload-layout">
    <div class="upload-row">
      <label for="identity">Proof of Identity <span class="required">*</span></label>
      <div class="input-group">
        <select id="identity-type" class="uniform-select">
          <option>Current signed passport</option>
          <option>Current photocard Driving License</option>
          <option>National Identity Card</option>
          <option>Electoral Identity Card</option>
        </select>
        <input type="file" id="identity" name="identity" multiple hidden onchange="showFiles(this, 'identity-files')">
        <span id="identity-files">No files selected</span>
      </div>
    </div>

    <div class="upload-row">
      <label for="address">Proof of Address <span class="required">*</span></label>
      <div class="input-group">
        <select id="address-type" class="uniform-select">
          <option>Utility Bill (last 3 months)</option>
          <option>Mobile Bill (last 3 months)</option>
          <option>Bank Statement (last 3 months)</option>
          <option>Government Issued ID with Name and Address</option>
        </select>
        <input type="file" id="address" name="address" multiple hidden onchange="showFiles(this, 'address-files')">
        <span id="address-files">No files selected</span>
      </div>
    </div>
  </div>
</div>

 <!-- Application Form (Common for both account types) -->
<div class="document-upload-layout">
    <h3>Application Form</h3>
    <div class="upload-row">
        <label for="application-method">Submission Method</label>
        <div class="input-group">
            <select id="application-method" class="uniform-select">
                <option value="">Select submission method</option>
                <option value="online">Online Submission</option>
                <option value="offline">Offline Submission</option>
            </select>
        </div>
    </div>

    <div class="upload-row" id="application-upload-row" style="display:none;">
        <label for="application">Upload Application</label>
        <div class="input-group">
            <input type="file" id="application" name="application" hidden onchange="showFiles(this, 'application-files')">
            <span id="application-files">No file selected</span>
        </div>
    </div>
</div>

<!-- Checkbox comes right after Primary section -->
<div class="only-holder-question">
  <label>
    <input type="checkbox" id="only-account-holder" checked>
    I am the only account holder
  </label>
</div>

<!-- Secondary Section -->
<div id="secondary-section">
  <h3>Secondary Account Holder</h3>
  <div class="document-upload-layout">
    <div class="upload-row">
      <label for="secondary-identity">Proof of Identity</label>
      <div class="input-group">
        <select id="secondary-identity-type" class="uniform-select">
          <option>Current signed passport</option>
          <option>Current photocard Driving License</option>
          <option>National Identity Card</option>
          <option>Electoral Identity Card</option>
        </select>
        <input type="file" id="secondary-identity" name="secondary-identity" multiple hidden onchange="showFiles(this, 'secondary-identity-files')">
        <span id="secondary-identity-files">No files selected</span>
      </div>
    </div>

    <div class="upload-row">
      <label for="secondary-address">Proof of Address</label>
      <div class="input-group">
        <select id="secondary-address-type" class="uniform-select">
          <option>Utility Bill (last 3 months)</option>
          <option>Mobile Bill (last 3 months)</option>
          <option>Bank Statement (last 3 months)</option>
          <option>Government Issued ID with Name and Address</option>
        </select>
        <input type="file" id="secondary-address" name="secondary-address" multiple hidden onchange="showFiles(this, 'secondary-address-files')">
        <span id="secondary-address-files">No files selected</span>
      </div>
    </div>
  </div>
</div>

<!-- Buttons -->
<div class="button-container">
    <button onclick="">Save Changes</button>
    <button onclick="validateForm()">Proceed</button>
</div>

<script>
function showFiles(input, spanId) {
    const span = document.getElementById(spanId);
    if (input.files.length > 0) {
        const names = Array.from(input.files).map(f => f.name).join(", ");
        span.textContent = names;
    } else {
        span.textContent = "No files selected";
    }
}

function validateForm() {
    // Primary fields
    let identityType = document.getElementById("identity-type").value;
    let identityFiles = document.getElementById("identity").files;
    let addressType = document.getElementById("address-type").value;
    let addressFiles = document.getElementById("address").files;
    let appMethod = document.getElementById("application-method").value;
    let appFiles = document.getElementById("application").files;
    let onlyHolder = document.getElementById("only-account-holder").checked;

    // Secondary fields
    let secondaryIdentityType = document.getElementById("secondary-identity-type").value;
    let secondaryIdentityFiles = document.getElementById("secondary-identity").files;
    let secondaryAddressType = document.getElementById("secondary-address-type").value;
    let secondaryAddressFiles = document.getElementById("secondary-address").files;

    // Primary checks
    if (!identityType || identityFiles.length === 0) {
        alert("Please provide proof of identity (type and at least one file) for primary account holder.");
        return;
    }
    if (!addressType || addressFiles.length === 0) {
        alert("Please provide proof of address (type and at least one file) for primary account holder.");
        return;
    }
    if (!appMethod) {
        alert("Please select a submission method.");
        return;
    }
  
    // Secondary checks if checkbox is unchecked
    if (!onlyHolder) {
        if (!secondaryIdentityType || secondaryIdentityFiles.length === 0) {
            alert("Please provide proof of identity (type and at least one file) for secondary account holder.");
            return;
        }
        if (!secondaryAddressType || secondaryAddressFiles.length === 0) {
            alert("Please provide proof of address (type and at least one file) for secondary account holder.");
            return;
        }
    }

    // If everything is valid
    window.location.href = "/fcc_kyc?id=fcc_kyc_individual_video_kyc";
}
</script>

        <name>Follow Up Mail</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[(function() {
  var REMINDER_DAYS = 5;

  var nowGdt = new GlideDateTime();
  var nextGdt = new GlideDateTime(nowGdt);
  nextGdt.addDaysLocalTime(REMINDER_DAYS);

  // update fields
  current.chaser_count = 1;
  current.last_chaser_date = nowGdt;
  current.next_chaser_due = nextGdt;

  // add a work note for visibility in activity stream
  current.work_notes = "Follow-up manual mail (Chaser #1) sent on " + nowGdt.getDisplayValue() +
    ". Next chaser due on " + nextGdt.getDisplayValue() + ".";

  current.setWorkflow(false);
  current.update();

  gs.addInfoMessage("Follow-up mail sent. Count=" + current.chaser_count +
    ", Next due=" + nextGdt.getDisplayValue());

  action.setRedirectURL(current); // stay on record
})();
]]></script>

        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var riskLevel = current.risk_level; 
    var expiryDate = new GlideDateTime();

    if (riskLevel == 'High') {
        expiryDate.addDaysUTC(365); // +1 year
    } else if (riskLevel == 'Medium') {
        expiryDate.addDaysUTC(1095); // +3 years
    } else if (riskLevel == 'Low') {
        expiryDate.addDaysUTC(1825); // +5 years
    }

    current.kyc_expiry = expiryDate; 
})(current, previous);
]]></script>

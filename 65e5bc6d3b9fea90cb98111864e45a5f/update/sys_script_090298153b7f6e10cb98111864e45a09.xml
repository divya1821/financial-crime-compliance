        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

  // If previously On Hold (250) but now moved out
  if (previous.state == '250' && current.state != '250') {
    current.next_chaser_due = '';
    current.work_notes = "Chaser schedule cleared automatically: Case moved out of On Hold.";
    current.setWorkflow(false);
    current.update();
  }

})(current, previous);

]]></script>

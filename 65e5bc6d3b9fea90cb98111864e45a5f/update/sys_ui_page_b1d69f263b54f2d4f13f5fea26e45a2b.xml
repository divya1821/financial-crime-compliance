        <client_script><![CDATA[// Setup referer URL for navigation
var url = new GlideURL();
url.setEncode(false);
url.setFromCurrent();
url.deleteParam('sysparm_record_scope');
$('referer').value = url.getURL();

// Context menu for each property
function showPropertyContext(event, id) {
    var mcm = new GwtContextMenu('context_menu_property_' + id);
    mcm.clear();
    mcm.addURL("${gs.getMessage('Edit Property')}", "sys_properties.do?sysparm_query=name=" + id, "gsft_main");
    mcm.addHref("${gs.getMessage('Copy Name To Clipboard')}", "copyToClipboard('" + id + "')");
    return contextShow(event, mcm.getID(), 500, 0, 0);
}

// Color preview handler
function upgradeColor(id) {
    var input = $(id);
    var preview = $('example.' + id);
    if (!input || !preview) return;

    var color = input.value;
    try {
        preview.style.backgroundColor = color;
    } catch (ex) {
        alert('Invalid color: ' + color);
        input.value = '';
        preview.style.backgroundColor = 'white';
    }
}

// Accessibility: auto-focus save button
document.getElementById('saveBtn').focus();
]]></client_script>
        <description>This UI page contains the list of system properties for financial crime compliance application</description>

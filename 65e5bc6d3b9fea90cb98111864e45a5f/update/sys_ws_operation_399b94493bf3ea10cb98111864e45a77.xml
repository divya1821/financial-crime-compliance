        <operation_script><![CDATA[(function process(request, response) {
    try {
        var body = request.body.data;  // Veriff sends JSON payloads
        gs.info("Veriff webhook received: " + JSON.stringify(body));
 
        // Example: store in a log table
        var gr = new GlideRecord("syslog");
        gr.initialize();
        gr.payload = JSON.stringify(body);
        gr.insert();
 
        response.setStatus(200);
        response.setBody({received: true});
    } catch (e) {
        gs.error("Error in Veriff webhook: " + e.message);
        response.setStatus(500);
        response.setBody({error: e.message});
    }
})(request, response);]]></operation_script>

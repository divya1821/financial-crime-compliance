    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description>Contact Us UI page for user inquiries and communication.</description>
        <direct>false</direct>
        <endpoint>x_vuram_financia_0_contact_us.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide">

    <html>

    <head>
        <style>
            body {
                margin: 0;
                padding: 0;
                background-color: #383838;
                font-family: 'Segoe UI', 'Montserrat', sans-serif;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .timingDiv {
                display: none !important;
            }

            body>div[style*="position: fixed"][style*="bottom"][style*="right"] {
                display: none !important;
            }


            .card {
                background: white;
                padding: 40px 30px;
                border-radius: 20px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
                text-align: center;
                width: 100%;
                max-width: 450px;
            }

            .card h1 {
                margin: 0;
                font-size: 32px;
                font-weight: bold;
                color: #333;
            }

            .card p {
                font-size: 16px;
                color: #000;
                margin: 20px 0 30px;
            }

            .contact-button {
                background-color: #4caf50;
                color: white;
                font-weight: bold;
                font-size: 16px;
                border: none;
                border-radius: 10px;
                padding: 14px 28px;
                cursor: pointer;
                transition: background-color 0.3s ease;
                text-decoration: none;
                display: inline-block;
            }

            .contact-button:hover {
                background-color: #43a047;
            }
        </style>
    </head>

    <body>
        <div class="card">
            <h1>WNS-Vuram</h1>
			<h6>ServiceNow Partner </h6>
            <p>servicenowsupport@wns.com</p>
            <a href="https://vuram.com/contact-us/" target="_blank" class="contact-button">Contact WNS Vuram</a>
        </div>
        <script>
            setTimeout(function() {
                // Try to remove any floating element in bottom-right
                const floatingElems = document.querySelectorAll('div[style*="position: fixed"][style*="bottom"][style*="right"]');
                floatingElems.forEach(elem => elem.style.display = 'none');

                // Also try to remove known debug class
                const debugElem = document.querySelector('.sn-debug-timer');
                if (debugElem) debugElem.style.display = 'none';
            }, 1000); // 1 second after load
        </script>

    </body>

    </html>
</j:jelly>]]></html>

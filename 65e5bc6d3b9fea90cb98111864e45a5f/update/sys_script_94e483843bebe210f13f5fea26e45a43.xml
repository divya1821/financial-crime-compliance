        <script><![CDATA[(function executeRule(current /*, previous*/) {
  // generate temp password
  var chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXTZabcdefghiklmnopqrstuvwxyz";
  var string_length = 8, randomstring = '';
  for (var i = 0; i < string_length; i++) {
    var rnum = Math.floor(Math.random() * chars.length);
    randomstring += chars.substring(rnum, rnum + 1);
  }

  // set password + force reset (no update() in Before)
  current.user_password.setDisplayValue(randomstring);
  //current.password_needs_reset = false;

  // fire the event registered in your scope
  gs.eventQueue('x_vuram_financia_0.user.password', current, current.getUniqueValue(), randomstring);
})(current);
]]></script>
